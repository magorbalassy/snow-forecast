{
  "priority": 200,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": "1",
        "number_of_replicas": "1",
        "default_pipeline": "snow-forecast"
      }
    },
    "mappings": {
      "runtime": {
        "heatmap_label": {
          "type": "keyword",
          "script": {
            "source": "emit(doc['name'].value + '\n' + doc['total_snow_cm'].value + ' cm')",
            "lang": "painless"
          }
        },
        "wind_label": {
          "type": "keyword",
          "script": {
            "lang": "painless",
            "source": "if (doc['max_wind_kmh_48h'].size() == 0) { emit(doc['name'].value); } else { emit(doc['name'].value + '\n' + doc['max_wind_kmh_48h'].value + ' km/h'); }"
          }
        }
      },
      "dynamic_templates": [],
      "properties": {
        "geo": {
          "type": "geo_point"
        },
        "country": {
          "type": "keyword"
        },
        "@timestamp": {
          "type": "date"
        },
        "total_snow_cm": {
          "type": "float"
        },
        "name": {
          "type": "keyword"
        },
        "level": {
          "type": "keyword"
        },
        "forecasts": {
          "type": "nested",
          "properties": {
            "date": {
              "format": "yyyy-MM-dd",
              "type": "date"
            },
            "freezing_level": {
              "ignore_malformed": true,
              "type": "integer"
            },
            "snow": {
              "type": "float"
            },
            "humidity": {
              "ignore_malformed": true,
              "type": "integer"
            },
            "time": {
              "type": "keyword"
            },
            "wind": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              }
            },
            "wind_speed": {
              "type": "integer"
            },
            "wind_dir": {
              "type": "keyword"
            }
          }
        },
        "elevation_m": {
          "type": "integer"
        },
        "max_wind_kmh_48h": {
          "type": "integer"
        }
      }
    }
  },
  "index_patterns": [
    "snow-forecast*"
  ],
  "composed_of": [],
  "ignore_missing_component_templates": []
}
